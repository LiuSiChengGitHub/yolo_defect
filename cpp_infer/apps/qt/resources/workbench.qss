/* Dark workbench. theme::styleSheet() replaces every at-sign color token
   below with the matching theme::palette() value before applying it.
   Areas are separated by tone and spacing; borders are kept for focus only. */

QWidget { font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI"; font-size: 13px; color: @text; }
QMainWindow, QWidget#workbenchSurface, QFrame#topBar, QFrame#statusBar { background: @window; }
QScrollArea#sidebarScroll, QWidget#sidebarViewport, QWidget#sidebarContent { background: @window; border: none; }
QToolTip { background: @raised; color: @text; border: 1px solid @border_strong; padding: 6px 9px; font-size: 12px; }

/* Title bar */
QToolButton#logo { border: none; background: transparent; padding: 0; }
QLabel#title { font-family: "Segoe UI Variable Display", "Segoe UI", "Microsoft YaHei UI"; color: @text; font-size: 14px; font-weight: 600; }
QLabel#subtitle { color: @text_muted; font-size: 12px; }
QLabel#stateBadge { border-radius: 11px; padding: 4px 12px; font-size: 12px; font-weight: 600; color: @text_secondary; background: @raised; }

/* Panels and sections */
QFrame#panel { background: @panel; border: 1px solid @border; border-radius: 10px; }
QFrame#sidebarSection { background: transparent; border: none; }
QFrame#divider { background: @divider; border: none; min-height: 1px; max-height: 1px; }
QLabel#sectionTitle { font-size: 13px; font-weight: 600; color: @text; }
QLabel#viewTitle { font-size: 13px; font-weight: 600; color: @text; }
QLabel#fieldLabel { color: @text_secondary; font-size: 12px; }
QLabel#muted { color: @text_muted; font-size: 12px; }

/* Input mode segments */
QFrame#inputMode { background: @field; border: none; border-radius: 8px; }
QToolButton#segment { border: none; border-radius: 6px; background: transparent; color: @text_muted; padding: 6px 4px; font-size: 12px; font-weight: 600; }
QToolButton#segment:hover { color: @text; }
QToolButton#segment:checked { background: @raised_hover; color: @text; }
QToolButton#segment:disabled { color: @text_disabled; }
QToolButton#segment:checked:disabled { background: @raised; color: @text_muted; }

/* Fields: filled, borderless until focused */
QLineEdit, QSpinBox { border: 1px solid transparent; background: @field; border-radius: 7px; selection-background-color: @accent_soft; selection-color: @text; }
QLineEdit { padding: 7px 9px; }
QLineEdit:hover, QSpinBox:hover { background: @raised; }
QLineEdit:focus, QSpinBox:focus { border-color: @accent_line; background: @field; }
QLineEdit:disabled, QSpinBox:disabled { color: @text_disabled; background: @panel; border-color: @divider; }
QSpinBox { padding: 6px 28px 6px 10px; min-height: 20px; font-family: "Cascadia Mono", "Consolas"; }
QSpinBox::up-button, QSpinBox::down-button { subcontrol-origin: padding; width: 24px; border: none; background: transparent; }
QSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 6px; }
QSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 6px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: @raised_hover; }
QSpinBox::up-arrow { image: url(:/icons/chevron-up.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 10px; height: 10px; }

/* Buttons: flat fills, no gradients or glows */
QPushButton { border: none; border-radius: 7px; background: @raised; padding: 7px 12px; color: @text; }
QPushButton:hover { background: @raised_hover; }
QPushButton:pressed { background: @border_strong; }
QPushButton:disabled { color: @text_disabled; background: transparent; }
QPushButton#browseButton { padding: 0; background: @field; }
QPushButton#browseButton:hover { background: @raised_hover; }
QPushButton#runButton { color: @on_accent; background: @accent; padding: 10px 14px; font-size: 13px; font-weight: 600; }
QPushButton#runButton:hover { background: @accent_bright; }
QPushButton#runButton:pressed { background: @accent_deep; }
QPushButton#runButton:disabled { color: @text_disabled; background: @raised; }
QPushButton#stopButton { color: @danger; background: @danger_soft; padding: 10px 14px; font-weight: 600; }
QPushButton#stopButton:hover { background: @danger_line; }
QPushButton#stopButton:disabled { color: @text_disabled; background: transparent; }
QPushButton#openSummaryButton, QPushButton#openJsonButton, QPushButton#openOutputButton { padding: 6px 12px; font-size: 12px; }

/* Effective model parameters */
QLabel#modelDetails { font-family: "Cascadia Mono", "Consolas", "Microsoft YaHei UI"; background: @field; border: none; border-radius: 7px; padding: 8px 10px; font-size: 12px; color: @text; }
QLabel#modelDetails[loaded="false"] { color: @text_muted; }
QLabel#parameterLabel { color: @text_muted; font-size: 12px; }
QLabel#parameterValue, QLabel#scoreThreshold, QLabel#nmsThreshold { font-family: "Cascadia Mono", "Consolas"; color: @text; font-size: 12px; }
QLabel#classNames, QLabel#modelPath, QLabel#runtimeConfigPath { font-family: "Cascadia Mono", "Consolas", "Microsoft YaHei UI"; color: @text_secondary; font-size: 11px; }
QToolButton#modelDetailsToggle { color: @text_secondary; border: none; background: transparent; padding: 4px 0; font-size: 12px; }
QToolButton#modelDetailsToggle:hover { color: @text; }
QToolButton#modelDetailsToggle:disabled { color: @text_disabled; }

/* Image viewer */
QFrame#viewToolbar { background: transparent; border: none; }
QToolButton#viewAction { border: none; border-radius: 6px; background: transparent; padding: 3px 5px; color: @text_secondary; font-family: "Cascadia Mono", "Consolas"; font-size: 11px; font-weight: 600; }
QToolButton#viewAction:hover { background: @raised; color: @text; }
QToolButton#viewAction:pressed { background: @raised_hover; }
QToolButton#viewAction:disabled { color: @text_disabled; }

/* Results */
QLabel#resultSummary { color: @text; font-weight: 600; font-size: 12px; }
QLabel#batchSummary { color: @text_secondary; font-size: 12px; }
QLabel#itemDetails { color: @text_secondary; font-size: 12px; }
QLabel#itemDetails[state="error"] { color: @danger; }
QPlainTextEdit#itemError { font-family: "Cascadia Mono", "Consolas", "Microsoft YaHei UI"; border: none; border-radius: 7px; background: @danger_soft; color: @danger; padding: 4px 6px; font-size: 11px; }
QTabWidget::pane { border: none; background: transparent; }
QTabBar::tab { background: transparent; color: @text_muted; padding: 6px 12px; margin: 0 4px 8px 0; border: none; border-radius: 7px; font-weight: 600; }
QTabBar::tab:hover:!selected { color: @text; }
QTabBar::tab:selected { background: @raised; color: @text; }
QTableView { border: none; background: transparent; alternate-background-color: @row_alt; selection-background-color: @selection; selection-color: @text; outline: 0; }
QHeaderView { background: transparent; border: none; }
QHeaderView::section { background: transparent; color: @text_muted; border: none; border-bottom: 1px solid @divider; padding: 6px 8px; font-size: 11px; font-weight: 600; }
QTableCornerButton::section { background: transparent; border: none; }

/* Status bar */
QFrame#statusBar { border-top: 1px solid @divider; }
QLabel#statusMessage { color: @text_muted; font-size: 12px; }
QLabel#statusMessage[state="error"] { color: @danger; }
QProgressBar { border: none; background: @raised; border-radius: 2px; max-height: 4px; min-height: 4px; }
QProgressBar::chunk { border-radius: 2px; background: @accent; }

/* Scroll bars, splitter and context menus */
QScrollBar:vertical { border: none; background: transparent; width: 8px; margin: 2px 0; }
QScrollBar:horizontal { border: none; background: transparent; height: 8px; margin: 0 2px; }
QScrollBar::handle:vertical { background: @border_strong; border-radius: 4px; min-height: 36px; }
QScrollBar::handle:horizontal { background: @border_strong; border-radius: 4px; min-width: 36px; }
QScrollBar::handle:hover { background: @text_muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: transparent; image: url(:/icons/grip.svg); }
QSplitter::handle:hover { background: @raised; border-radius: 4px; }
QMenu { background: @raised; border: 1px solid @border_strong; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 5px; background: transparent; color: @text; }
QMenu::item:selected { background: @raised_hover; color: @text; }
QMenu::item:disabled { color: @text_disabled; }
QMenu::separator { height: 1px; background: @divider; margin: 4px 6px; }
